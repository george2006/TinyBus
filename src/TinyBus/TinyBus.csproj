<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageId>TinySuite.TinyBus</PackageId>
    <Product>TinyBus</Product>
    <Description>Source-generated reliable fire-and-forget commands for .NET with generated topology, retries, and dead-letter handling.</Description>
    <PackageTags>tinybus;messaging;commands;source-generator;dotnet;dependency-injection</PackageTags>
    <PackageReleaseNotes>TinyBus 0.1.0-alpha.1 provides reliable fire-and-forget commands, generated handler discovery and topology, retry and dead-letter coordination, and transport startup readiness. Event publishing, request/reply, sagas, scheduling, and outbox integration are not included.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.10" />
    <InternalsVisibleTo Include="TinyBus.PostgreSql.Tests" />
    <InternalsVisibleTo Include="TinyBus.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../TinyBus.SourceGen/TinyBus.SourceGen.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <None Include="../TinyBus.SourceGen/bin/$(Configuration)/netstandard2.0/TinyBus.SourceGen.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
