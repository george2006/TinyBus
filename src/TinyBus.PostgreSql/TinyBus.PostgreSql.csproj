<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageId>TinySuite.TinyBus.PostgreSql</PackageId>
    <Product>TinyBus PostgreSQL</Product>
    <Description>PostgreSQL transport for TinyBus with built-in migrations, competing consumers, delayed retries, and durable dead-letter storage.</Description>
    <PackageTags>tinybus;messaging;commands;postgresql;postgres;dotnet</PackageTags>
    <PackageReleaseNotes>TinyBus PostgreSQL 0.1.0-alpha.1 provides additive command topology, durable command rows, leased competing-consumer claims, delayed retries, and transactional dead-letter moves. Upgrade every TinyBus package together.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TinyBus/TinyBus.csproj" />
    <InternalsVisibleTo Include="TinyBus.PostgreSql.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.9" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
